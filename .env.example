# ==============================================================================
# AI Flood Intelligence System — Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="AI Flood Intelligence System"
API_V1_STR=/api/v1

# Security & Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database Connection (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/flood_warning_db

# External Weather & Data APIs
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# CORS Settings (JSON list of allowed origins)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
